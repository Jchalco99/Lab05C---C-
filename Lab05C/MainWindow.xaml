<Window x:Class="Lab05C.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab05C"
        mc:Ignorable="d"
        Title="Gestión de Clientes" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="8,5"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            TextBlock.TextAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#003D6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="0,0,10,10">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="GESTIÓN DE CLIENTES" 
                          FontSize="28" 
                          FontWeight="Bold" 
                          Foreground="White"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Sistema de Administración CRUD con Búsqueda" 
                          FontSize="14" 
                          Foreground="#BDC3C7"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Buttons Panel -->
        <WrapPanel Grid.Row="1" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   Orientation="Horizontal">
            <Button x:Name="btnListarClientes" 
                   Content="📋 Listar Clientes" 
                   Style="{StaticResource ModernButtonStyle}"
                   Click="BtnListarClientes_Click"/>
            <Button x:Name="btnRegistrarCliente" 
                   Content="➕ Registrar Cliente" 
                   Style="{StaticResource ModernButtonStyle}"
                   Background="#27AE60"
                   Click="BtnRegistrarCliente_Click"/>
            <Button x:Name="btnEditarCliente" 
                   Content="✏️ Editar Cliente" 
                   Style="{StaticResource ModernButtonStyle}"
                   Background="#F39C12"
                   Click="BtnEditarCliente_Click"/>
            <Button x:Name="btnEliminarCliente" 
                   Content="🗑️ Eliminar Cliente" 
                   Style="{StaticResource ModernButtonStyle}"
                   Background="#E74C3C"
                   Click="BtnEliminarCliente_Click"/>
        </WrapPanel>

        <!-- Search Panel -->
        <Border Grid.Row="2" Background="White" 
               Margin="20,1"
               CornerRadius="5"
               BorderBrush="#E0E0E0" 
               BorderThickness="1">
            <Grid Margin="15,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                          Text="🔍 Buscar:" 
                          VerticalAlignment="Center" 
                          FontWeight="SemiBold" 
                          FontSize="14"
                          Foreground="#2C3E50"
                          Margin="0,0,10,0"/>

                <TextBox x:Name="txtBuscar" 
                        Grid.Column="1"
                        Height="35"
                        Padding="10,5"
                        FontSize="14"
                        BorderBrush="#BDC3C7"
                        BorderThickness="2"
                        VerticalContentAlignment="Center"
                        Margin="0,0,10,0"
                        KeyDown="TxtBuscar_KeyDown"
                        TextChanged="TxtBuscar_TextChanged"/>

                <Button x:Name="btnBuscar" 
                       Grid.Column="2"
                       Content="🔍 Buscar" 
                       Style="{StaticResource ModernButtonStyle}"
                       Background="#9B59B6"
                       Padding="15,8"
                       Margin="0,0,5,0"
                       Click="BtnBuscar_Click"/>

                <Button x:Name="btnLimpiarBusqueda" 
                       Grid.Column="3"
                       Content="❌" 
                       Style="{StaticResource ModernButtonStyle}"
                       Background="#95A5A6"
                       Padding="10,8"
                       ToolTip="Limpiar búsqueda"
                       Click="BtnLimpiarBusqueda_Click"/>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Border Grid.Row="3" Background="White" 
               Margin="20,0,20,20" 
               CornerRadius="10"
               BorderBrush="#E0E0E0" 
               BorderThickness="1">
            <Grid x:Name="contentGrid">
                <!-- DataGrid for listing clients -->
                <Grid x:Name="gridListaClientes" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Results info -->
                    <Border Grid.Row="0" Background="#ECF0F1" Padding="10,5" Margin="10,10,10,0">
                        <TextBlock x:Name="lblResultados" 
                                  Text="Mostrando todos los clientes" 
                                  FontWeight="SemiBold"
                                  Foreground="#2C3E50"/>
                    </Border>

                    <DataGrid x:Name="dgClientes" 
                             Grid.Row="1"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             IsReadOnly="True"
                             GridLinesVisibility="Horizontal"
                             HeadersVisibility="Column"
                             Background="White"
                             RowBackground="White"
                             AlternatingRowBackground="#F8F9FA"
                             BorderThickness="0"
                             Margin="10"
                             SelectionMode="Single"
                             MouseDoubleClick="DgClientes_MouseDoubleClick">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#34495E"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="10,8"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID Cliente" Binding="{Binding IdCliente}" Width="80"/>
                            <DataGridTextColumn Header="Compañía" Binding="{Binding NombreCompañia}" Width="150"/>
                            <DataGridTextColumn Header="Contacto" Binding="{Binding NombreContacto}" Width="120"/>
                            <DataGridTextColumn Header="Cargo" Binding="{Binding CargoContacto}" Width="120"/>
                            <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="100"/>
                            <DataGridTextColumn Header="País" Binding="{Binding Pais}" Width="100"/>
                            <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Form for registering/editing clients -->
                <ScrollViewer x:Name="formScrollViewer" 
                            Visibility="Collapsed"
                            VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="40,20">
                        <TextBlock x:Name="lblTituloFormulario"
                                  Text="REGISTRAR NUEVO CLIENTE" 
                                  FontSize="24" 
                                  FontWeight="Bold" 
                                  Foreground="#2C3E50"
                                  HorizontalAlignment="Center" 
                                  Margin="0,0,0,30"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Column -->
                            <StackPanel Grid.Column="0">
                                <Label Content="ID Cliente:" FontWeight="Bold" Margin="0,5"/>
                                <TextBox x:Name="txtIdCliente" Height="35" Padding="10,5" FontSize="14" MaxLength="5"/>

                                <Label Content="Nombre de Compañía:" FontWeight="Bold" Margin="0,15,0,5"/>
                                <TextBox x:Name="txtNombreCompañia" Height="35" Padding="10,5" FontSize="14" MaxLength="50"/>

                                <Label Content="Nombre de Contacto:" FontWeight="Bold" Margin="0,15,0,5"/>
                                <TextBox x:Name="txtNombreContacto" Height="35" Padding="10,5" FontSize="14" MaxLength="50"/>

                                <Label Content="Cargo del Contacto:" FontWeight="Bold" Margin="0,15,0,5"/>
                                <TextBox x:Name="txtCargoContacto" Height="35" Padding="10,5" FontSize="14" MaxLength="50"/>

                                <Label Content="Dirección:" FontWeight="Bold" Margin="0,15,0,5"/>
                                <TextBox x:Name="txtDireccion" Height="35" Padding="10,5" FontSize="14" MaxLength="50"/>

                                <Label Content="Ciudad:" FontWeight="Bold" Margin="0,15,0,5"/>
                                <TextBox x:Name="txtCiudad" Height="35" Padding="10,5" FontSize="14" MaxLength="50"/>
                            </StackPanel>

                            <!-- Right Column -->
                            <StackPanel Grid.Column="2">
                                <Label Content="Región:" FontWeight="Bold" Margin="0,5"/>
                                <TextBox x:Name="txtRegion" Height="35" Padding="10,5" FontSize="14" MaxLength="50"/>

                                <Label Content="Código Postal:" FontWeight="Bold" Margin="0,15,0,5"/>
                                <TextBox x:Name="txtCodPostal" Height="35" Padding="10,5" FontSize="14" MaxLength="50"/>

                                <Label Content="País:" FontWeight="Bold" Margin="0,15,0,5"/>
                                <TextBox x:Name="txtPais" Height="35" Padding="10,5" FontSize="14" MaxLength="50"/>

                                <Label Content="Teléfono:" FontWeight="Bold" Margin="0,15,0,5"/>
                                <TextBox x:Name="txtTelefono" Height="35" Padding="10,5" FontSize="14" MaxLength="50"/>

                                <Label Content="Fax:" FontWeight="Bold" Margin="0,15,0,5"/>
                                <TextBox x:Name="txtFax" Height="35" Padding="10,5" FontSize="14" MaxLength="50"/>
                            </StackPanel>
                        </Grid>

                        <!-- Buttons -->
                        <WrapPanel HorizontalAlignment="Center" 
                                  Margin="0,30,0,20"
                                  Orientation="Horizontal">
                            <Button x:Name="btnGuardar" 
                                   Content="💾 Guardar Cliente" 
                                   Style="{StaticResource ModernButtonStyle}"
                                   Background="#27AE60"
                                   Click="BtnGuardar_Click"/>
                            <Button x:Name="btnActualizar" 
                                   Content="🔄 Actualizar Cliente" 
                                   Style="{StaticResource ModernButtonStyle}"
                                   Background="#F39C12"
                                   Visibility="Collapsed"
                                   Click="BtnActualizar_Click"/>
                            <Button x:Name="btnLimpiar" 
                                   Content="🗑️ Limpiar Campos" 
                                   Style="{StaticResource ModernButtonStyle}"
                                   Background="#95A5A6"
                                   Click="BtnLimpiar_Click"/>
                            <Button x:Name="btnCancelar" 
                                   Content="❌ Cancelar" 
                                   Style="{StaticResource ModernButtonStyle}"
                                   Background="#E74C3C"
                                   Click="BtnCancelar_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Welcome Message -->
                <StackPanel x:Name="welcomePanel" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center">
                    <TextBlock Text="👥" 
                              FontSize="80" 
                              HorizontalAlignment="Center" 
                              Foreground="#BDC3C7"/>
                    <TextBlock Text="Bienvenido al Sistema de Gestión de Clientes" 
                              FontSize="20" 
                              FontWeight="SemiBold" 
                              Foreground="#7F8C8D"
                              HorizontalAlignment="Center" 
                              Margin="0,20"/>
                    <TextBlock Text="Selecciona una opción del menú superior para comenzar" 
                              FontSize="14" 
                              Foreground="#95A5A6"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="🔍 Usa la búsqueda para filtrar clientes por compañía" 
                              FontSize="12" 
                              FontStyle="Italic"
                              Foreground="#BDC3C7"
                              HorizontalAlignment="Center"
                              Margin="0,5"/>
                    <TextBlock Text="💡 Doble clic en un cliente de la lista para editarlo" 
                              FontSize="12" 
                              FontStyle="Italic"
                              Foreground="#BDC3C7"
                              HorizontalAlignment="Center"
                              Margin="0,5"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>