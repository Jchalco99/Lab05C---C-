<Window x:Class="Lab05C.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab05C"
        mc:Ignorable="d"
        Title="Gestión de Clientes" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="0,0,10,10">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="GESTIÓN DE CLIENTES" 
                          FontSize="28" 
                          FontWeight="Bold" 
                          Foreground="White"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Sistema de Administración CRUD" 
                          FontSize="14" 
                          Foreground="#BDC3C7"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Buttons Panel -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center">
            <Button x:Name="btnListarClientes" 
                   Content="📋 Listar Clientes" 
                   Style="{StaticResource ModernButtonStyle}"
                   Click="BtnListarClientes_Click"/>
            <Button x:Name="btnRegistrarCliente" 
                   Content="➕ Registrar Cliente" 
                   Style="{StaticResource ModernButtonStyle}"
                   Background="#27AE60"
                   Click="BtnRegistrarCliente_Click"/>
            <Button x:Name="btnEditarCliente" 
                   Content="✏️ Editar Cliente" 
                   Style="{StaticResource ModernButtonStyle}"
                   Background="#F39C12"
                   Click="BtnEditarCliente_Click"/>
            <Button x:Name="btnEliminarCliente" 
                   Content="🗑️ Eliminar Cliente" 
                   Style="{StaticResource ModernButtonStyle}"
                   Background="#E74C3C"
                   Click="BtnEliminarCliente_Click"/>
        </StackPanel>

        <!-- Content Area -->
        <Border Grid.Row="2" Background="White" 
               Margin="20" 
               CornerRadius="10"
               BorderBrush="#E0E0E0" 
               BorderThickness="1">
            <Grid x:Name="contentGrid">
                <!-- DataGrid for listing clients -->
                <DataGrid x:Name="dgClientes" 
                         Visibility="Collapsed"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         IsReadOnly="True"
                         GridLinesVisibility="Horizontal"
                         HeadersVisibility="Column"
                         Background="White"
                         RowBackground="White"
                         AlternatingRowBackground="#F8F9FA"
                         BorderThickness="0"
                         Margin="10"
                         SelectionMode="Single"
                         MouseDoubleClick="DgClientes_MouseDoubleClick">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#34495E"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="10,8"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8,5"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID Cliente" Binding="{Binding IdCliente}" Width="80"/>
                        <DataGridTextColumn Header="Compañía" Binding="{Binding NombreCompañia}" Width="150"/>
                        <DataGridTextColumn Header="Contacto" Binding="{Binding NombreContacto}" Width="120"/>
                        <DataGridTextColumn Header="Cargo" Binding="{Binding CargoContacto}" Width="120"/>
                        <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="100"/>
                        <DataGridTextColumn Header="País" Binding="{Binding Pais}" Width="100"/>
                        <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Form for registering/editing clients -->
                <ScrollViewer x:Name="formScrollViewer" 
                            Visibility="Collapsed"
                            VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="40,20">
                        <TextBlock x:Name="lblTituloFormulario"
                                  Text="REGISTRAR NUEVO CLIENTE" 
                                  FontSize="24" 
                                  FontWeight="Bold" 
                                  Foreground="#2C3E50"
                                  HorizontalAlignment="Center" 
                                  Margin="0,0,0,30"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Column -->
                            <StackPanel Grid.Column="0">
                                <Label Content="ID Cliente:" FontWeight="Bold" Margin="0,5"/>
                                <TextBox x:Name="txtIdCliente" Height="35" Padding="10,5" FontSize="14" MaxLength="5"/>

                                <Label Content="Nombre de Compañía:" FontWeight="Bold" Margin="0,15,0,5"/>
                                <TextBox x:Name="txtNombreCompañia" Height="35" Padding="10,5" FontSize="14" MaxLength="50"/>

                                <Label Content="Nombre de Contacto:" FontWeight="Bold" Margin="0,15,0,5"/>
                                <TextBox x:Name="txtNombreContacto" Height="35" Padding="10,5" FontSize="14" MaxLength="50"/>

                                <Label Content="Cargo del Contacto:" FontWeight="Bold" Margin="0,15,0,5"/>
                                <TextBox x:Name="txtCargoContacto" Height="35" Padding="10,5" FontSize="14" MaxLength="50"/>

                                <Label Content="Dirección:" FontWeight="Bold" Margin="0,15,0,5"/>
                                <TextBox x:Name="txtDireccion" Height="35" Padding="10,5" FontSize="14" MaxLength="50"/>

                                <Label Content="Ciudad:" FontWeight="Bold" Margin="0,15,0,5"/>
                                <TextBox x:Name="txtCiudad" Height="35" Padding="10,5" FontSize="14" MaxLength="50"/>
                            </StackPanel>

                            <!-- Right Column -->
                            <StackPanel Grid.Column="2">
                                <Label Content="Región:" FontWeight="Bold" Margin="0,5"/>
                                <TextBox x:Name="txtRegion" Height="35" Padding="10,5" FontSize="14" MaxLength="50"/>

                                <Label Content="Código Postal:" FontWeight="Bold" Margin="0,15,0,5"/>
                                <TextBox x:Name="txtCodPostal" Height="35" Padding="10,5" FontSize="14" MaxLength="50"/>

                                <Label Content="País:" FontWeight="Bold" Margin="0,15,0,5"/>
                                <TextBox x:Name="txtPais" Height="35" Padding="10,5" FontSize="14" MaxLength="50"/>

                                <Label Content="Teléfono:" FontWeight="Bold" Margin="0,15,0,5"/>
                                <TextBox x:Name="txtTelefono" Height="35" Padding="10,5" FontSize="14" MaxLength="50"/>

                                <Label Content="Fax:" FontWeight="Bold" Margin="0,15,0,5"/>
                                <TextBox x:Name="txtFax" Height="35" Padding="10,5" FontSize="14" MaxLength="50"/>
                            </StackPanel>
                        </Grid>

                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,30,0,20">
                            <Button x:Name="btnGuardar" 
                                   Content="💾 Guardar Cliente" 
                                   Style="{StaticResource ModernButtonStyle}"
                                   Background="#27AE60"
                                   Click="BtnGuardar_Click"/>
                            <Button x:Name="btnActualizar" 
                                   Content="🔄 Actualizar Cliente" 
                                   Style="{StaticResource ModernButtonStyle}"
                                   Background="#F39C12"
                                   Visibility="Collapsed"
                                   Click="BtnActualizar_Click"/>
                            <Button x:Name="btnLimpiar" 
                                   Content="🗑️ Limpiar Campos" 
                                   Style="{StaticResource ModernButtonStyle}"
                                   Background="#95A5A6"
                                   Click="BtnLimpiar_Click"/>
                            <Button x:Name="btnCancelar" 
                                   Content="❌ Cancelar" 
                                   Style="{StaticResource ModernButtonStyle}"
                                   Background="#E74C3C"
                                   Click="BtnCancelar_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Welcome Message -->
                <StackPanel x:Name="welcomePanel" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center">
                    <TextBlock Text="👥" 
                              FontSize="80" 
                              HorizontalAlignment="Center" 
                              Foreground="#BDC3C7"/>
                    <TextBlock Text="Bienvenido al Sistema de Gestión de Clientes" 
                              FontSize="20" 
                              FontWeight="SemiBold" 
                              Foreground="#7F8C8D"
                              HorizontalAlignment="Center" 
                              Margin="0,20"/>
                    <TextBlock Text="Selecciona una opción del menú superior para comenzar" 
                              FontSize="14" 
                              Foreground="#95A5A6"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="💡 Doble clic en un cliente de la lista para editarlo" 
                              FontSize="12" 
                              FontStyle="Italic"
                              Foreground="#BDC3C7"
                              HorizontalAlignment="Center"
                              Margin="0,10"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>